# Leave unset to use the local backend default (http://localhost:5001).
# Set this for another development or deployed API endpoint.
VITE_API_BASE_URL=http://localhost:5001

# Required for magic-link sign-in on the deployed app.
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
